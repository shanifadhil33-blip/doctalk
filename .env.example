# Auth.js (Google). Placeholders only. Do not commit real values.
AUTH_SECRET=replace_with_a_long_random_string
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gemini API (embeddings and chat)
GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_MODEL=gemini-embedding-2
CHAT_MODEL=gemini-3.5-flash-lite

# Optional OpenRouter fallback. Use a free model id.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_free_model
